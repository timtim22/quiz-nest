NODE_ENV=development
PORT=3000

# `docker compose up -d` (repo root) starts a Postgres with these credentials.
# If you use your own Postgres, change the user/password/host to match.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/quiz_nest?schema=public"

# Comma-separated list of origins allowed to call the API from a browser.
CORS_ORIGIN=http://localhost:5173

# Signs login tokens. Make your own: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string-of-48-plus-characters

# Where the web app lives. Used for links in emails (e.g. password reset).
WEB_URL=http://localhost:5173

# Database for `npm run test:e2e`. Its name must contain "test": the tests delete everything in it.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/quiz_nest_test?schema=public"
