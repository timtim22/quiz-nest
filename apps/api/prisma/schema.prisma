// Database schema. After changing it, run `npm run db:migrate` to create a migration.
//
// Conventions:
// - Model and field names are camelCase in code; tables and columns are
//   snake_case in Postgres (@@map / @map), so raw SQL never needs quotes.
// - IDs are time-ordered UUIDs (v7).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// A school, college or academy. Teachers, subjects and exams will belong to one.
model Organization {
  id        String    @id @default(uuid(7)) @db.Uuid
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  subjects  Subject[]
  users     User[]

  @@map("organizations")
}

/// Same values as UserRole in @quiz-nest/shared. Students don't have accounts:
/// they join exams with an exam code and roll number.
enum UserRole {
  ADMIN
  TEACHER

  @@map("user_role")
}

enum UserStatus {
  ACTIVE
  DISABLED

  @@map("user_status")
}

/// A teacher or admin who logs in with email and password.
model User {
  id             String     @id @default(uuid(7)) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  name           String
  /// Always stored lowercase (the shared Zod schemas lowercase it).
  email          String     @unique
  /// bcrypt hash. Never select this unless you're checking a password.
  passwordHash   String     @map("password_hash")
  role           UserRole   @default(TEACHER)
  status         UserStatus @default(ACTIVE)
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]

  @@index([organizationId])
  @@map("users")
}

/// One logged-in browser. Holds a hash of its refresh token, never the token itself.
model Session {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  /// Set when the token is swapped for a new one (see SessionsService.rotate).
  rotatedAt DateTime? @map("rotated_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// A single-use "forgot password" link. Stores a hash of the token, never the token itself.
model PasswordResetToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

/// A subject an organization teaches, e.g. "Physics".
model Subject {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  description    String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  chapters     Chapter[]

  @@unique([organizationId, name])
  @@map("subjects")
}

/// A chapter inside a subject, e.g. "Motion".
model Chapter {
  id          String   @id @default(uuid(7)) @db.Uuid
  subjectId   String   @map("subject_id") @db.Uuid
  name        String
  description String?
  /// Lower numbers are listed first.
  position    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topics  Topic[]

  @@unique([subjectId, name])
  @@map("chapters")
}

/// A topic inside a chapter, e.g. "Velocity".
model Topic {
  id          String   @id @default(uuid(7)) @db.Uuid
  chapterId   String   @map("chapter_id") @db.Uuid
  name        String
  description String?
  /// Lower numbers are listed first.
  position    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([chapterId, name])
  @@map("topics")
}
